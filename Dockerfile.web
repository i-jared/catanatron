FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app/catanatron_core:/app/catanatron_server

RUN pip install --upgrade pip

COPY . .
RUN pip install --no-cache-dir -r requirements.security.lock.txt && pip check

EXPOSE 5000

ENV FLASK_DEBUG=1
ENV FLASK_APP=catanatron_server/catanatron_server
ENV FLASK_RUN_HOST=0.0.0.0

CMD flask run
